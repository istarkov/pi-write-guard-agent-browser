	"description": "macOS Seatbelt write-guard for Pi shell commands: read anywhere, write only inside allowed roots.",
	"type": "module",
	"license": "MIT",
	"author": "istarkov",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/istarkov/pi-write-guard-agent-browser.git"
	},
	"homepage": "https://github.com/istarkov/pi-write-guard-agent-browser#readme",
	"bugs": {
		"url": "https://github.com/istarkov/pi-write-guard-agent-browser/issues"
	},
	"keywords": ["pi-package", "pi", "extension", "sandbox", "seatbelt", "macos"],
	"engines": {
		"node": ">=22.19.0"
	},
